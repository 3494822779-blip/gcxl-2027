# Operations: align, target_grasp, approach_grasp, grasp, first_grasp,
# move, turn, claw, camera, stop. SI units except explicit *_deg.
string operation
# Required for target_grasp and its approach_grasp/first_grasp aliases.
bool has_target_class
int32 target_class_id
float64 timeout_sec  # 0 selects 60 seconds; all target grasp operations default to 180
float64 distance_m  # signed for move; discard uses configured distance
float64 angle_deg   # signed CCW for turn; absolute for claw/camera
float64 speed_mps   # 0 selects configured speed; turn uses per-wheel speed
bool discard_after  # Deprecated: true is rejected; discard operation is disabled.
---
bool success
string message
uint64 track_id
---
string phase
float64 elapsed_sec
uint64 track_id
bool clearance
